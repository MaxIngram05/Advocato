{
  "name": "avocado",
  "version": "0.1.0",
  "private": true,
  "description": "Avocado — Google Docs add-on that builds a sourced legal argumentation matrix (Québec civil law).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "npm run build:ui && npm run build:server && node scripts/copy-manifest.mjs",
    "build:ui": "vite build",
    "build:server": "tsx scripts/build-server.ts",
    "push": "npm run build && clasp push",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "capture:caij": "tsx scripts/capture-caij.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "mammoth": "1.10.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@google/clasp": "3.3.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/google-apps-script": "2.0.7",
    "@types/node": "22.18.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "0.25.9",
    "eslint": "9.39.1",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "jest-axe": "10.0.0",
    "@types/jest-axe": "3.5.9",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.9.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.1",
    "vitest": "3.2.4"
  }
}
